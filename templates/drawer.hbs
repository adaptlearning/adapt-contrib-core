<div class="drawer__inner">

  <div class="drawer__toolbar">

    <div class="drawer__back">
      <button class="btn-icon drawer__btn drawer__back-btn js-drawer-back-btn" aria-label="{{_globals._accessibility._ariaLabels.previous}}">
        <span class="icon" aria-hidden="true"></span>
      </button>
    </div>

    <div class="drawer__close">
      <button class="btn-icon drawer__btn drawer__close-btn js-drawer-close-btn" aria-label="{{_globals._accessibility._ariaLabels.closeDrawer}}">
        <span class="icon" aria-hidden="true"></span>
      </button>
    </div>

  </div>

  <div class="drawer__title js-drawer-title aria-label" id="drawer-heading">
    <div class="drawer__title-inner js-drawer-title-inner" role="heading" aria-level="1">{{_globals._accessibility._ariaLabels.drawer}}</div>
  </div>

  <div class="drawer__holder js-drawer-holder"></div>

  {{{a11y_wrap_focus}}}

</div>
